# Walrus Memory. Create the account at https://memory.walrus.xyz (Enoki-sponsored, no gas).
# Leave both empty to run against the offline mock client.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=ranti
# A write is a job that is not "done" until the blob is persisted, which takes
# tens of seconds on the hosted relayer. This is the hard ceiling for the whole
# call; the settle budget below is what the SDK actually polls for.
MEMWAL_TIMEOUT_SECONDS=90
# The relayer allows 60 weighted requests a minute. Polling a settle every 1.5s
# for the whole ceiling spent that budget on one turn and rate limited the next.
# A longer interval and a shorter budget mean a wait makes a handful of status
# calls, not dozens. A job that has not settled inside the budget is retried by
# the next turn rather than held open.
MEMWAL_POLL_INTERVAL_MS=5000
MEMWAL_SETTLE_TIMEOUT_SECONDS=30

# LLM providers. The first configured provider wins; the rest form the failover chain.
# All three speak the OpenAI wire format.
# Single-key form. Used when GROQ_API_KEYS is not set.
GROQ_API_KEY=
# Multi-key form for Groq: comma-separated keys, no spaces required. When set it
# wins over GROQ_API_KEY. Every key is trimmed, empty entries and repeats are
# dropped, and order is preserved (the first key is preferred). On a 429 the
# provider rotates to the next key at once instead of sleeping, rests the
# rate-limited key until its Retry-After, and retires a key that returns 401 or
# 403 for the rest of the process. Example:
# GROQ_API_KEYS=key_one,key_two,key_three
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional local model. Off by default: a fresh clone uses the deterministic
# offline model instead of pointing at a daemon that may not be running.
# Set OLLAMA_ENABLED=1 after starting `ollama serve` to add it as the last
# provider in the failover chain.
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# Telegram surface. Create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# The assistant's own name. User-facing only: it never touches the memory
# namespaces, which stay on MEMWAL_NAMESPACE_PREFIX, so renaming cannot orphan a
# single stored memory. This is the one name every self-introduction uses, so a
# retired name is never surfaced even when an old record still contains it.
BOT_NAME=Cheta
# Assistant names retired by an earlier rename, comma separated. An old stored
# record that is about the assistant under one of these names is not a fact
# about the person, so it is kept out of the listing, the greeting and the
# prompt even though the append-only blob is never rewritten. Leave empty to
# disable the filter; entries are trimmed and repeats are dropped.
# RANTI_RETIRED_NAMES=Ranti
RANTI_RETIRED_NAMES=
# Picture sent with the /start and /help welcome, relative to the repository root.
RANTI_WELCOME_IMAGE=assets/cheta-welcome.png

# Internal plumbing like "1 accepted, persisting" in chat. Off by default; turn
# it on only to show the memory engine at work in a demo.
RANTI_MEMORY_RECEIPTS=0

# Voice notes and audio files. Groq Whisper is free on the same key as the chat
# provider, so this defaults to GROQ_API_KEY and can be pointed elsewhere.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3
TRANSCRIPTION_TIMEOUT_SECONDS=60

# Runtime
RANTI_ENVIRONMENT=development
RANTI_DATABASE_PATH=artifacts/ranti.db
# Keep a free https host awake with a periodic /health ping. 0 disables it.
RANTI_KEEPALIVE=1
# Proactive memory: when a known user returns after this many hours, the first
# reply opens by naming one or two facts that are actually stored. Below the
# threshold a fast back-and-forth stays one conversation and is not re-greeted.
RANTI_RESUME_AFTER_HOURS=6

# Device pairing. /pair on one client shows a short code to enter on another,
# which attaches it to the same memory space. The code lives this many seconds
# (600 = 10 minutes) and is stored only as a hash, domain separated by the
# pepper below.
RANTI_PAIRING_CODE_TTL_SECONDS=600
RANTI_PAIRING_PEPPER=ranti-pairing
