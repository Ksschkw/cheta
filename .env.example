# Walrus Memory. Create the account at https://memory.walrus.xyz (Enoki-sponsored, no gas).
# Leave both empty to run against the offline mock client.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=ranti
# A write is a job that is not "done" until the blob is persisted, which takes
# tens of seconds on the hosted relayer. Keep this above the SDK's 60s poll
# default, otherwise the boundary fires before the SDK can report its job id.
MEMWAL_TIMEOUT_SECONDS=90

# LLM providers. The first configured provider wins; the rest form the failover chain.
# All three speak the OpenAI wire format.
GROQ_API_KEY=
GROQ_MODEL=qwen3-32b
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional local model. Off by default: a fresh clone uses the deterministic
# offline model instead of pointing at a daemon that may not be running.
# Set OLLAMA_ENABLED=1 after starting `ollama serve` to add it as the last
# provider in the failover chain.
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# Telegram surface. Create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Runtime
RANTI_ENVIRONMENT=development
RANTI_DATABASE_PATH=artifacts/ranti.db
